[Unit]
Description=Calm Ideas Wall C++ REST service
After=network.target

[Service]
Type=simple
User=calm_ideas_wall
Group=calm_ideas_wall
WorkingDirectory=/opt/calm_ideas_wall
Environment=PORT=8080

ExecStart=/opt/calm_ideas_wall/calm_ideas_wall

Restart=on-failure
RestartSec=5

# Production hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/calm_ideas_wall

[Install]
WantedBy=multi-user.target

