#!/sbin/openrc-run

# Copyright 1999-2025 Calm Idea Wall Contributors
# Distributed under the terms of the MIT License

name="calm_idea_wall"
description="Calm Idea Wall C++ REST service"

pidfile="/run/${name}.pid"
command="/opt/calm_idea_wall/calm_idea_wall"
command_user="calm_idea_wall"
command_group="calm_idea_wall"
command_background="yes"
command_args=""

PORT="${PORT:-8080}"

depend() {
    need net
    use logger
}

start_pre() {
    eaccess /opt/calm_idea_wall/calm_idea_wall
    eaccess -U ${command_user}:${command_group} /opt/calm_idea_wall

    export PORT
}

start() {
    ebegin "Starting ${name}"
    start-stop-daemon --start \
        --background \
        --make-pidfile \
        --pidfile "${pidfile}" \
        --chuid "${command_user}:${command_group}" \
        --chdir /opt/calm_idea_wall \
        --exec "${command}"
}

stop() {
    ebegin "Stopping ${name}"
    start-stop-daemon --stop \
        --pidfile "${pidfile}" \
        --retry 10
}

status() {
    start-stop-daemon --status \
        --pidfile "${pidfile}"
}

